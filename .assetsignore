# Cloudflare Workers (static assets) ne fait PAS l'exclusion automatique de
# .git/node_modules/.DS_Store que faisait l'ancien Cloudflare Pages : sans ce
# fichier, wrangler deploie tout le contenu du repo tel quel, y compris .git
# (decouvert expose publiquement le 27/07/2026 - .git/config, .git/HEAD,
# .git/logs/HEAD repondaient 200 sur le site en production).
.git
.git/**
.gitignore
.assetsignore
node_modules
node_modules/**
.DS_Store
wrangler.jsonc

# Notes de developpement : rien n'y renvoie depuis le site, et elles citent
# des chemins du depot prive (docs/, CLAUDE.md). Pas de raison de les servir
# sur trustline.identity-ops.com. (Le depot GitHub reste public : les
# exclure ici ne fait que reduire la surface, ca ne les rend pas privees.)
README.md
fonts/README.md
